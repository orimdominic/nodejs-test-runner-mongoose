{
  "name": "nodejs-test-runner-mongoose",
  "version": "1.0.0",
  "description": "Sample for writing tests for MongoDB with the Node.js test runner and mongodb-memory-server",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx index.ts",
    "test": "node --test --experimental-strip-types --import tsx --import ./test.setup.mjs "
  },
  "keywords": [
    "node.js",
    "test",
    "mongodb",
    "mongodb-memory-server",
    "typescript"
  ],
  "author": "Orim Dominic",
  "license": "ISC",
  "devDependencies": {
    "mongodb-memory-server": "^9.1.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "mongoose": "^8.9.6",
    "tsx": "^4.19.2"
  }
}
